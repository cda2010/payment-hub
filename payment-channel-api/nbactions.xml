<?xml version="1.0" encoding="UTF-8"?>
<!-- Config Run / Debug NetBeans pour le gateway (profil local = Postgres + Redis). -->
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Dspring.profiles.active=local</spring-boot.run.jvmArguments>
            <spring-boot.run.profiles>local</spring-boot.run.profiles>
            <!-- Évite WeakKeyException si NetBeans injecte JWT_SECRET vide -->
            <Env.JWT_SECRET>change-me-to-a-very-long-secret-key-at-least-256-bits</Env.JWT_SECRET>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Dspring.profiles.active=local -Xdebug -Xrunjdwp:transport=dt_socket,server=n,address=${jpda.address}</spring-boot.run.jvmArguments>
            <spring-boot.run.profiles>local</spring-boot.run.profiles>
            <Env.JWT_SECRET>change-me-to-a-very-long-secret-key-at-least-256-bits</Env.JWT_SECRET>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>process-classes</goal>
            <goal>org.springframework.boot:spring-boot-maven-plugin:run</goal>
        </goals>
        <properties>
            <spring-boot.run.jvmArguments>-Dspring.profiles.active=local</spring-boot.run.jvmArguments>
            <spring-boot.run.profiles>local</spring-boot.run.profiles>
            <Env.JWT_SECRET>change-me-to-a-very-long-secret-key-at-least-256-bits</Env.JWT_SECRET>
        </properties>
    </action>
</actions>
