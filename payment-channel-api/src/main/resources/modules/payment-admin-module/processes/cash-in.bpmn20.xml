<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:pay="http://payment-gateway/schema/bpmn/pay" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://payment-gateway/catalog" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <process id="cashIn" name="Cash-in (Catalog)" isExecutable="true">
    <documentation>
      Montant → compte destination → réseau agent → frais → rules → récap → OTP →
      code dépôt → attente encaissement agent → crédit → notify.
    </documentation>
    <startEvent id="start" name="Start" />
    <sequenceFlow id="flow_start" sourceRef="start" targetRef="CAPTURE_AMOUNT" />
    <userTask id="CAPTURE_AMOUNT" name="01 Capture amount" flowable:formKey="cash-in-amount" />
    <sequenceFlow id="flow_01" sourceRef="CAPTURE_AMOUNT" targetRef="SELECT_DESTINATION" />
    <userTask id="SELECT_DESTINATION" name="02 Select destination account" flowable:formKey="cash-in-destination" />
    <sequenceFlow id="flow_02" sourceRef="SELECT_DESTINATION" targetRef="SELECT_AGENT_CHANNEL" />
    <userTask id="SELECT_AGENT_CHANNEL" name="03 Select agent network" flowable:formKey="cash-in-agent" />
    <sequenceFlow id="flow_03" sourceRef="SELECT_AGENT_CHANNEL" targetRef="CALCULATE_FEES" />
    <serviceTask id="CALCULATE_FEES" name="04 Calculate fees" flowable:delegateExpression="${catalogStepDelegate}" pay:capability="CALCULATE_FEES" />
    <sequenceFlow id="flow_04" sourceRef="CALCULATE_FEES" targetRef="EVALUATE_RULES" />
    <serviceTask id="EVALUATE_RULES" name="05 Evaluate rules" flowable:delegateExpression="${catalogStepDelegate}" pay:capability="EVALUATE_RULES" pay:actorRole="DESTINATION" />
    <sequenceFlow id="flow_05" sourceRef="EVALUATE_RULES" targetRef="CONFIRM" />
    <userTask id="CONFIRM" name="06 Recap confirm" flowable:formKey="product-recap" />
    <sequenceFlow id="flow_06" sourceRef="CONFIRM" targetRef="WAIT_AGENT_COLLECT" />
    <serviceTask id="WAIT_AGENT_COLLECT" name="09 Wait agent collect cash" flowable:delegateExpression="${catalogStepDelegate}" pay:capability="WAIT">
      <incoming>flow_06</incoming>
    </serviceTask>
    <sequenceFlow id="flow_09" sourceRef="WAIT_AGENT_COLLECT" targetRef="EXECUTE_CASHIN" />
    <serviceTask id="EXECUTE_CASHIN" name="10 Credit destination" flowable:delegateExpression="${catalogStepDelegate}" pay:capability="EXECUTE_CASHIN" pay:actorRole="DESTINATION" pay:operation="TRANSFERT" />
    <sequenceFlow id="flow_10" sourceRef="EXECUTE_CASHIN" targetRef="NOTIFY" />
    <serviceTask id="NOTIFY" name="11 Notify" flowable:delegateExpression="${catalogStepDelegate}" pay:capability="NOTIFY" />
    <sequenceFlow id="flow_11" sourceRef="NOTIFY" targetRef="end" />
    <endEvent id="end" name="End" />
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_cashIn">
    <bpmndi:BPMNPlane id="BPMNPlane_cashIn" bpmnElement="cashIn">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
