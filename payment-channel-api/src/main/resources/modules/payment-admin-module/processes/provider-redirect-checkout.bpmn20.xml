<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://payment-gateway/provider"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <!-- Wave / Card : CREATE_PAYMENT (redirect) → attente callback -->
  <process id="providerRedirectCheckout" name="Provider Redirect Checkout" isExecutable="true">
    <documentation>Redirect + wait callback (Wave, carte 3DS).</documentation>

    <startEvent id="start" name="Start"/>
    <sequenceFlow id="flow_start" sourceRef="start" targetRef="createPayment"/>

    <serviceTask id="createPayment" name="Init paiement / redirect"
                 flowable:delegateExpression="${gatewayProviderCallDelegate}"/>
    <sequenceFlow id="flow_create" sourceRef="createPayment" targetRef="waitCallback"/>

    <userTask id="waitCallback" name="Attente retour / callback"
              flowable:formKey="provider-wait-callback"/>
    <sequenceFlow id="flow_end" sourceRef="waitCallback" targetRef="end"/>

    <endEvent id="end" name="End"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_providerRedirectCheckout">
    <bpmndi:BPMNPlane id="BPMNPlane_providerRedirectCheckout" bpmnElement="providerRedirectCheckout">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="100" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="createPayment_di" bpmnElement="createPayment">
        <omgdc:Bounds x="180" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="waitCallback_di" bpmnElement="waitCallback">
        <omgdc:Bounds x="350" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="520" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <omgdi:waypoint x="136" y="180"/><omgdi:waypoint x="180" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_create_di" bpmnElement="flow_create">
        <omgdi:waypoint x="300" y="180"/><omgdi:waypoint x="350" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_di" bpmnElement="flow_end">
        <omgdi:waypoint x="470" y="180"/><omgdi:waypoint x="520" y="180"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
