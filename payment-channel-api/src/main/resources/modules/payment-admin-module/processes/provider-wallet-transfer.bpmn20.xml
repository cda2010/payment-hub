<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             targetNamespace="http://payment-gateway/provider"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">

  <process id="providerWalletTransfer" name="Provider Wallet Transfer" isExecutable="true">
    <documentation>Transfert multi-rails : formulaire → OTP → TRANSFER_EXECUTE.</documentation>

    <startEvent id="start" name="Start"/>
    <sequenceFlow id="flow_start" sourceRef="start" targetRef="collectTransfer"/>

    <userTask id="collectTransfer" name="Saisie transfert"
              flowable:formKey="provider-wallet-transfer"/>
    <sequenceFlow id="flow_transfer" sourceRef="collectTransfer" targetRef="generateOtp"/>

    <serviceTask id="generateOtp" name="Générer OTP"
                 flowable:delegateExpression="${gatewayProviderCallDelegate}"/>
    <sequenceFlow id="flow_otp_gen" sourceRef="generateOtp" targetRef="enterOtp"/>

    <userTask id="enterOtp" name="Saisie OTP" flowable:formKey="provider-otp-code"/>
    <sequenceFlow id="flow_otp" sourceRef="enterOtp" targetRef="transferExecute"/>

    <serviceTask id="transferExecute" name="Exécuter transfert"
                 flowable:delegateExpression="${gatewayProviderCallDelegate}"/>
    <sequenceFlow id="flow_end" sourceRef="transferExecute" targetRef="end"/>

    <endEvent id="end" name="End"/>
  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_providerWalletTransfer">
    <bpmndi:BPMNPlane id="BPMNPlane_providerWalletTransfer" bpmnElement="providerWalletTransfer">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <omgdc:Bounds x="100" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="collectTransfer_di" bpmnElement="collectTransfer">
        <omgdc:Bounds x="180" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="generateOtp_di" bpmnElement="generateOtp">
        <omgdc:Bounds x="350" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="enterOtp_di" bpmnElement="enterOtp">
        <omgdc:Bounds x="520" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="transferExecute_di" bpmnElement="transferExecute">
        <omgdc:Bounds x="690" y="140" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end">
        <omgdc:Bounds x="860" y="162" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_start_di" bpmnElement="flow_start">
        <omgdi:waypoint x="136" y="180"/><omgdi:waypoint x="180" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_transfer_di" bpmnElement="flow_transfer">
        <omgdi:waypoint x="300" y="180"/><omgdi:waypoint x="350" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_otp_gen_di" bpmnElement="flow_otp_gen">
        <omgdi:waypoint x="470" y="180"/><omgdi:waypoint x="520" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_otp_di" bpmnElement="flow_otp">
        <omgdi:waypoint x="640" y="180"/><omgdi:waypoint x="690" y="180"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_end_di" bpmnElement="flow_end">
        <omgdi:waypoint x="810" y="180"/><omgdi:waypoint x="860" y="180"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
