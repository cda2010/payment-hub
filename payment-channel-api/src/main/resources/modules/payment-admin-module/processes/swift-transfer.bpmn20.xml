<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://payment-gateway/catalog" xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL BPMN20.xsd">
  <process id="swiftTransfer" name="SWIFT Transfer (Catalog)" isExecutable="true">
    <documentation>
      Parcours SWIFT : banque source → BIC/IBAN → montant/devise → validation BIC /
      conformité / limites / frais → confirm → approbation → OTP → exécution → wait → notify.
    </documentation>
    <startEvent id="start" name="Start" />
    <sequenceFlow id="flow_start" sourceRef="start" targetRef="SELECT_SOURCE_BANK" />
    <userTask id="SELECT_SOURCE_BANK" name="01 Select source bank" flowable:formKey="swift-source" />
    <sequenceFlow id="flow_01" sourceRef="SELECT_SOURCE_BANK" targetRef="CAPTURE_DESTINATION" />
    <userTask id="CAPTURE_DESTINATION" name="02 Capture destination" flowable:formKey="swift-destination" />
    <sequenceFlow id="flow_02" sourceRef="CAPTURE_DESTINATION" targetRef="CAPTURE_AMOUNT" />
    <userTask id="CAPTURE_AMOUNT" name="03 Capture amount" flowable:formKey="swift-amount" />
    <sequenceFlow id="flow_03" sourceRef="CAPTURE_AMOUNT" targetRef="VALIDATE_BIC" />
    <serviceTask id="VALIDATE_BIC" name="04 Validate BIC" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_04" sourceRef="VALIDATE_BIC" targetRef="CHECK_COMPLIANCE" />
    <serviceTask id="CHECK_COMPLIANCE" name="05 Compliance / AML" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_05" sourceRef="CHECK_COMPLIANCE" targetRef="CHECK_LIMITS" />
    <serviceTask id="CHECK_LIMITS" name="06 Check limits" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_06" sourceRef="CHECK_LIMITS" targetRef="CALCULATE_FEES" />
    <serviceTask id="CALCULATE_FEES" name="07 Calculate fees" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_07" sourceRef="CALCULATE_FEES" targetRef="CONFIRM" />
    <userTask id="CONFIRM" name="08 Confirm" flowable:formKey="swift-confirm" />
    <sequenceFlow id="flow_08" sourceRef="CONFIRM" targetRef="EVALUATE_APPROVAL" />
    <serviceTask id="EVALUATE_APPROVAL" name="08b Evaluate approval" flowable:delegateExpression="${gatewayTransferApprovalEvaluateDelegate}" />
    <sequenceFlow id="flow_08b" sourceRef="EVALUATE_APPROVAL" targetRef="gw_approvalNeeded" />
    <exclusiveGateway id="gw_approvalNeeded" name="Approval needed?" />
    <sequenceFlow id="flow_skip_approval" sourceRef="gw_approvalNeeded" targetRef="generateOtp">
      <conditionExpression xsi:type="tFormalExpression">${approvalLevelsRequired == null || approvalLevelsRequired &lt; 1}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_to_l1" sourceRef="gw_approvalNeeded" targetRef="APPROVAL_L1">
      <conditionExpression xsi:type="tFormalExpression">${approvalLevelsRequired &gt;= 1}</conditionExpression>
    </sequenceFlow>
    <userTask id="APPROVAL_L1" name="08c Approval L1" flowable:candidateGroups="${approvalCandidateGroupL1}" flowable:formKey="account-transfer-approval" />
    <sequenceFlow id="flow_l1_done" sourceRef="APPROVAL_L1" targetRef="gw_l1_result" />
    <exclusiveGateway id="gw_l1_result" name="L1 result" />
    <sequenceFlow id="flow_l1_reject" sourceRef="gw_l1_result" targetRef="APPROVAL_RETURNED">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_l1_to_l2" sourceRef="gw_l1_result" targetRef="APPROVAL_L2">
      <conditionExpression xsi:type="tFormalExpression">${approved == true &amp;&amp; approvalLevelsRequired &gt;= 2}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_l1_to_otp" sourceRef="gw_l1_result" targetRef="generateOtp">
      <conditionExpression xsi:type="tFormalExpression">${approved == true &amp;&amp; approvalLevelsRequired &lt; 2}</conditionExpression>
    </sequenceFlow>
    <userTask id="APPROVAL_L2" name="08d Approval L2" flowable:candidateGroups="${approvalCandidateGroupL2}" flowable:formKey="account-transfer-approval" />
    <sequenceFlow id="flow_l2_done" sourceRef="APPROVAL_L2" targetRef="gw_l2_result" />
    <exclusiveGateway id="gw_l2_result" name="L2 result" />
    <sequenceFlow id="flow_l2_reject" sourceRef="gw_l2_result" targetRef="APPROVAL_RETURNED">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_l2_to_l3" sourceRef="gw_l2_result" targetRef="APPROVAL_L3">
      <conditionExpression xsi:type="tFormalExpression">${approved == true &amp;&amp; approvalLevelsRequired &gt;= 3}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_l2_to_otp" sourceRef="gw_l2_result" targetRef="generateOtp">
      <conditionExpression xsi:type="tFormalExpression">${approved == true &amp;&amp; approvalLevelsRequired &lt; 3}</conditionExpression>
    </sequenceFlow>
    <userTask id="APPROVAL_L3" name="08e Approval L3" flowable:candidateGroups="${approvalCandidateGroupL3}" flowable:formKey="account-transfer-approval" />
    <sequenceFlow id="flow_l3_done" sourceRef="APPROVAL_L3" targetRef="gw_l3_result" />
    <exclusiveGateway id="gw_l3_result" name="L3 result" />
    <sequenceFlow id="flow_l3_reject" sourceRef="gw_l3_result" targetRef="APPROVAL_RETURNED">
      <conditionExpression xsi:type="tFormalExpression">${approved == false}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="flow_l3_to_otp" sourceRef="gw_l3_result" targetRef="generateOtp">
      <conditionExpression xsi:type="tFormalExpression">${approved == true}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="APPROVAL_RETURNED" name="Mark returned to initiator" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_returned_to_correct" sourceRef="APPROVAL_RETURNED" targetRef="CORRECT_TRANSFER" />
    <userTask id="CORRECT_TRANSFER" name="Correct and resubmit" flowable:formKey="account-transfer-return" />
    <sequenceFlow id="flow_correct_to_confirm" sourceRef="CORRECT_TRANSFER" targetRef="CONFIRM" />
    <serviceTask id="generateOtp" name="09 Authenticate — generate OTP" flowable:delegateExpression="${gatewayProviderCallDelegate}" />
    <sequenceFlow id="flow_09a" sourceRef="generateOtp" targetRef="EXECUTE_SWIFT" />
    <serviceTask id="EXECUTE_SWIFT" name="10 Execute SWIFT" flowable:delegateExpression="${gatewayProviderCallDelegate}">
      <incoming>flow_09a</incoming>
    </serviceTask>
    <sequenceFlow id="flow_10" sourceRef="EXECUTE_SWIFT" targetRef="WAIT_SETTLEMENT" />
    <serviceTask id="WAIT_SETTLEMENT" name="11 Wait settlement" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_11" sourceRef="WAIT_SETTLEMENT" targetRef="NOTIFY" />
    <serviceTask id="NOTIFY" name="12 Notify" flowable:delegateExpression="${gatewayCatalogStepDelegate}" />
    <sequenceFlow id="flow_12" sourceRef="NOTIFY" targetRef="end" />
    <endEvent id="end" name="End" />
  </process>
