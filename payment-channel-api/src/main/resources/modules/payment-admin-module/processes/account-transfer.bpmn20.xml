      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CONFIRM_di" bpmnElement="CONFIRM">
        <omgdc:Bounds x="1260" y="60" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DEBIT_di" bpmnElement="DEBIT">
