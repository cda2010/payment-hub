{
  "formio": {
    "display": "form",
    "components": [
      {
        "type": "hidden",
        "key": "sourceRail",
        "defaultValue": "WAVE",
        "input": true
      },
      {
        "type": "phoneNumber",
        "key": "msisdn",
        "label": "Mobile Wave (émetteur)",
        "placeholder": "22670001122",
        "input": true,
        "validate": {
          "required": true,
          "pattern": "^226\\d{8}$",
          "customMessage": "Format 226 + 8 chiffres"
        }
      },
      {
        "type": "phoneNumber",
        "key": "sourceAccount",
        "label": "Identifiant compte source (MSISDN)",
        "placeholder": "22670001122",
        "input": true,
        "validate": {
          "required": true,
          "pattern": "^226\\d{8}$"
        }
      },
      {
        "type": "button",
        "key": "submit",
        "label": "Submit",
        "input": true,
        "hidden": true
      }
    ]
  },
  "i18n": {
    "fr": {
      "Mobile Wave (émetteur)": "Mobile Wave (émetteur)",
      "Identifiant compte source (MSISDN)": "Identifiant compte source (MSISDN)"
    },
    "en": {
      "Mobile Wave (émetteur)": "Wave mobile (sender)",
      "Identifiant compte source (MSISDN)": "Source account id (MSISDN)"
    }
  }
}
