{
  "formio": {
    "display": "form",
    "components": [
      {
        "type": "htmlelement",
        "key": "recapPlaceholder",
        "tag": "p",
        "content": "Récapitulatif généré dynamiquement (configuration.recap)."
      },
      {
        "type": "checkbox",
        "key": "confirmRecap",
        "label": "Je confirme les informations du récapitulatif",
        "input": true,
        "defaultValue": false,
        "validate": { "required": true }
      },
      {
        "type": "button",
        "key": "submit",
        "label": "Submit",
        "input": true,
        "hidden": true
      }
