  },
  "gateway": {
    "nextAction": "FORM"
  },
  "i18n": {
    "fr": {
      "Je confirme les informations du récapitulatif": "Je confirme les informations du récapitulatif"
    },
    "en": {
      "Je confirme les informations du récapitulatif": "I confirm the summary details"
    }
  }
}
