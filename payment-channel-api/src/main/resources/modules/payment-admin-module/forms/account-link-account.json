    "display": "form",
    "components": [
      {
        "type": "phoneNumber",
        "key": "phoneNumber",
        "label": "Numéro / MSISDN à rattacher",
        "input": true,
        "validate": { "required": true }
      },
      {
        "type": "textfield",
        "key": "accountAlias",
        "label": "Alias (optionnel)",
        "input": true,
        "placeholder": "Ex. Mon Wave"
