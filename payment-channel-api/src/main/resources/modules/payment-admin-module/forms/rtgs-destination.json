{
  "formio": {
    "display": "form",
    "components": [
      {
        "type": "select",
        "key": "destRail",
        "label": "Banque destinataire",
        "input": true,
        "dataSrc": "values",
        "data": {
          "values": [
            { "label": "CORIS_BANK", "value": "CORIS_BANK" }
          ]
        },
        "widget": "choicesjs",
        "validate": { "required": true }
      },
      {
        "type": "textfield",
        "key": "destAccount",
        "label": "N° de compte bénéficiaire",
