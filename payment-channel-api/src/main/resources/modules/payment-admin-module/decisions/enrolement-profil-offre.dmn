<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/"
             id="definitions_enrolement_profil_offre"
             name="enrolement-profil-offre"
             namespace="https://payment-gateway/dmn/enrolement-profil-offre"
             exporter="payment-gateway"
             exporterVersion="1.0">

  <description>
    Segment + choix d'enrôlement → profil service et profil frais à affecter.
    AUCUN : ce profil n'est pas affecté.
    REFUS : la personne n'ouvre pas de compte.
    CREATION : elle ouvre le compte après l'identité, sans pièce, ou le compte est déjà reconnu.
    IDENTIFICATION : elle poursuit avec les pièces.
    Ajouter une ligne change les profils rattachés, sans modifier le mobile.
  </description>

  <inputData id="input_segment" name="segment">
    <variable name="segment" typeRef="string"/>
  </inputData>
  <inputData id="input_choix" name="choix">
    <variable name="choix" typeRef="string"/>
  </inputData>

  <decision id="decision_EnrolementProfilOffre" name="EnrolementProfilOffre">
    <variable name="offre" typeRef="string"/>
    <informationRequirement>
      <requiredInput href="#input_segment"/>
    </informationRequirement>
    <informationRequirement>
      <requiredInput href="#input_choix"/>
    </informationRequirement>
    <decisionTable id="dt_EnrolementProfilOffre" hitPolicy="FIRST">
      <input id="in_segment" label="segment">
        <inputExpression typeRef="string"><text>segment</text></inputExpression>
      </input>
      <input id="in_choix" label="choix">
        <inputExpression typeRef="string"><text>choix</text></inputExpression>
      </input>
      <output id="out_service" label="service" name="service" typeRef="string"/>
      <output id="out_frais" label="frais" name="frais" typeRef="string"/>

      <rule id="r_refus">
        <inputEntry><text>"RETAIL"</text></inputEntry>
        <inputEntry><text>"REFUS"</text></inputEntry>
        <outputEntry><text>"AUCUN"</text></outputEntry>
        <outputEntry><text>"AUCUN"</text></outputEntry>
      </rule>
      <rule id="r_creation">
        <inputEntry><text>"RETAIL"</text></inputEntry>
        <inputEntry><text>"CREATION"</text></inputEntry>
        <outputEntry><text>"RETAIL-STD"</text></outputEntry>
        <outputEntry><text>"RETAIL-FEE"</text></outputEntry>
      </rule>
      <rule id="r_identification">
        <inputEntry><text>"RETAIL"</text></inputEntry>
        <inputEntry><text>"IDENTIFICATION"</text></inputEntry>
        <outputEntry><text>"RETAIL-STD"</text></outputEntry>
        <outputEntry><text>"RETAIL-FEE"</text></outputEntry>
      </rule>
      <rule id="r_defaut">
        <inputEntry><text>-</text></inputEntry>
        <inputEntry><text>-</text></inputEntry>
        <outputEntry><text>"RETAIL-STD"</text></outputEntry>
        <outputEntry><text>"RETAIL-FEE"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
