// JDL definition for application 'pti' generated with command 'jhipster export-jdl'

entity UniteOrganisation (unite_organisation) {
  libelleUniteOrganisation String required,
  estSiege Boolean,
  codeUO String,
  numeroOrdre Integer,
  feuille Boolean,
  codeFse String,
  estFiliale Boolean
}
entity TypeUniteOrganisation (type_unite_organisation) {
  libelleTypeUO String,
  codeTypeUO String,
  niveau Integer
}
entity Personne (personne) {
  typePersonne TypePersonne,
  telephone String
}
entity Piece (piece) {
  referencePiece String required,
  dateDelivrance LocalDate,
  dateExpiration LocalDate,
  copie AnyBlob,
  lieuDelivrance String
}
entity TypePiece (type_piece) {
  codeTypePiece String required,
  libelleTypePiece String required
}
entity PersonnePhysique (personne_physique) {
  nomClient String required,
  prenomClient String required,
  dateNaissance LocalDate,
  personnePrevenir String,
  lieuNaissance String,
  sexe Sexe
}
entity Nationalite (nationalite) {
  code String,
  libelle String
}
entity PersonneMorale (personne_morale) {
  raisonSociale String required,
  registreCommerce String,
  numreoIfu String
}
entity Emetteur (emetteur) {
  code String
}
entity Beneficiaire (beneficiaire) {
  code String
}
entity Client (client) {
  codeClient String
}
entity Compte (compte) {
  etiquette String required,
  valeurCompte String,
  categorieCompte CategorieCompte
}
entity TypeCompte (type_compte) {
  codeTypeCompte Integer required,
  libelleTypeCompte String required
}
entity CompteBanque (compte_banque) {
  codeAgence String required,
  codeBanque String required,
  codeFse String
}
entity Devise (devise) {
  code String required,
  libelle String required,
  symbole String
}
entity CompteAutre (compte_autre) {
  solde BigDecimal
}
entity EtiquetteCompte (etiquette_compte) {
  code String,
  obligatoire Boolean
}
entity TableauFrais (tableau_frais) {
  poidsNum Integer
}
entity LigneFrais (ligne_frais) {
  typeFrais TypeTarif,
  maximun Integer,
  minimun Integer,
  valeur Integer
}
entity Canal (canal) {
  codeCanal String required,
  libelleCanal String required
}
entity Operation (operation) {
  montantOp BigDecimal,
  montantFrais BigDecimal,
  dateOperation ZonedDateTime,
  statut StatutOperation,
  codeRetrait String,
  secret String,
  codeOperation String,
  dateExpiration LocalDate,
  motif String,
  codeExterne String
}
entity TypeService (type_service) {
  libelle String required,
  cmpteClientSournce Boolean,
  cmpteClientDest Boolean,
  operationClient Boolean,
  fraisApplicable Boolean
}
entity PointVente (point_vente) {
  codePointVente String required,
  libellePointVente String required
}
entity FournisseurService (fournisseur_service) {
  codeFse String required,
  libelleFse String required
}
entity TableauRepartitionCommission (tableau_repartition_commission) {
  niveaoOperation Integer,
  dateDebut LocalDate,
  dateFin LocalDate
}
entity LigneRepartitionCommission (ligne_repartition_commission) {
  niveau Integer,
  valeur Integer
}
entity Autorisation (autorisation) {
  code String
}
entity Pays (pays) {
  codePays String required,
  libellePays String
}
entity EtiquetteComptable (etiquette_comptable) {
  code String
}
entity RepartionFraisEmAcq (repartion_frais_em_acq) {
  partEm Integer,
  partAcq Integer
}
entity Commission (commission) {
  montant BigDecimal,
  estPaye Boolean,
  datePaiement ZonedDateTime,
  dateEnregistrement ZonedDateTime
}
entity OperationAudit (operation_audit) {
  date ZonedDateTime,
  statutPrecedent StatutOperation,
  statutApres StatutOperation
}
entity Profil (profil) {
  nom String required,
  description String
}

enum TypePersonne {
  PHYSIQUE,
  MORALE
}

enum Sexe {
  MASCULIN,
  FEMININ
}

enum CategorieCompte {
  BANQUE,
  AUTRE
}

enum TypeTarif {
  FIXE,
  POURCENTAGE
}

enum StatutOperation {
  ENCOURS,
  ENATTENTE,
  ANNULLE,
  PAYE
}

